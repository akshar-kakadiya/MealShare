# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Database (PostgreSQL with PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mealshare?schema=public"

# Authentication & JWT
JWT_ACCESS_SECRET="mealshare_super_secure_jwt_access_secret_key_2026"
JWT_ACCESS_EXPIRATION="900s"
JWT_REFRESH_SECRET="mealshare_super_secure_jwt_refresh_secret_key_2026"
JWT_REFRESH_EXPIRATION="7d"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# S3 / MinIO Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="mealshare-evidence"
