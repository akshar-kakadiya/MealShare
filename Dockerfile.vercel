
# MealShare backend - Vercel container deployment

# Stage 1: Build Spring Boot application
FROM eclipse-temurin:17-jdk-alpine AS builder

WORKDIR /build

COPY backend/.mvn/ .mvn/
COPY backend/mvnw backend/pom.xml ./

RUN chmod +x ./mvnw && ./mvnw dependency:resolve -B

COPY backend/src/ src/

RUN ./mvnw clean package -DskipTests -B

# Stage 2: Runtime
FROM eclipse-temurin:17-jre-alpine

RUN addgroup -S mealshare && adduser -S mealshare -G mealshare

WORKDIR /app

COPY --from=builder /build/target/mealshare-backend-*.jar app.jar

RUN chown -R mealshare:mealshare /app

USER mealshare

# Vercel supplies PORT at runtime.
ENV PORT=8081 \
    SPRING_PROFILES_ACTIVE=prod \
    JAVA_OPTS="-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=50.0 -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=48m -Xss512k -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError"

EXPOSE 8081

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -Dserver.port=${PORT:-8081} -jar app.jar"]
